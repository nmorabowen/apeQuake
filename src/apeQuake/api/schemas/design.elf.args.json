{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmorabowen.github.io/apeQuake/schemas/apeQuake-1/design.elf.args.json",
  "title": "design.elf args",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "const": "asce7"
        },
        "edition": {
          "enum": [
            "7-10",
            "7-16",
            "7-22"
          ],
          "description": "ASCE 7 edition (default 7-16)."
        },
        "sds": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "SDS [g]."
        },
        "sd1": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "SD1 [g]."
        },
        "s1": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Mapped S1 [g]."
        },
        "tl": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "Long-period transition TL [s]."
        },
        "riskCategory": {
          "enum": [
            "I",
            "II",
            "III",
            "IV"
          ],
          "description": "Risk category (default II)."
        },
        "ie": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2,
          "description": "Ie; defaults to Table 1.5-2 for riskCategory."
        },
        "structureType": {
          "enum": [
            "steel_moment_frame",
            "concrete_moment_frame",
            "steel_eccentrically_braced_frame",
            "steel_buckling_restrained_braced_frame",
            "other"
          ],
          "description": "Table 12.8-2 structure type (default other)."
        },
        "applyUpperLimit": {
          "type": "boolean",
          "description": "Cap T at Cu Ta (Section 12.8.2; default true)."
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Effective seismic weight W (any force unit; V comes back in it)."
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "Response modification coefficient R."
        },
        "t": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "Analysis period T [s]; capped by Cu Ta (ASCE) or 1.3 Ta (NEC) when hn is given."
        },
        "hn": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "Structural height hn [m], for the approximate period."
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "weight": {
                "type": "number",
                "minimum": 0,
                "description": "Story weight, in the unit of w."
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Height above the base [m]."
              }
            },
            "required": [
              "weight",
              "height"
            ],
            "additionalProperties": false
          },
          "description": "Story weights and heights, for the vertical distribution."
        }
      },
      "required": [
        "code",
        "w",
        "r",
        "sds",
        "sd1",
        "s1",
        "tl"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "t"
          ]
        },
        {
          "required": [
            "hn"
          ]
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "const": "nec"
        },
        "z": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.5,
          "description": "Zone factor Z [g]."
        },
        "siteClass": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "region": {
          "$ref": "common.json#/$defs/region"
        },
        "importance": {
          "enum": [
            "esencial",
            "especial",
            "otra"
          ],
          "description": "Tabla 6 category (default otra)."
        },
        "phiP": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Plan irregularity coefficient (default 1)."
        },
        "phiE": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Elevation irregularity coefficient (default 1)."
        },
        "structureType": {
          "enum": [
            "acero_sin_arriostramientos",
            "acero_con_arriostramientos",
            "hormigon_porticos",
            "hormigon_con_muros"
          ],
          "description": "6.3.3 structure type for Ct, alpha (default hormigon_porticos)."
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Effective seismic weight W (any force unit; V comes back in it)."
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "Response modification coefficient R."
        },
        "t": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "Analysis period T [s]; capped by Cu Ta (ASCE) or 1.3 Ta (NEC) when hn is given."
        },
        "hn": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "Structural height hn [m], for the approximate period."
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "weight": {
                "type": "number",
                "minimum": 0,
                "description": "Story weight, in the unit of w."
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Height above the base [m]."
              }
            },
            "required": [
              "weight",
              "height"
            ],
            "additionalProperties": false
          },
          "description": "Story weights and heights, for the vertical distribution."
        }
      },
      "required": [
        "code",
        "w",
        "r",
        "z",
        "siteClass",
        "region"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "t"
          ]
        },
        {
          "required": [
            "hn"
          ]
        }
      ]
    }
  ]
}
