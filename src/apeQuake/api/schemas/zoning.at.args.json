{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmorabowen.github.io/apeQuake/schemas/apeQuake-1/zoning.at.args.json",
  "title": "zoning.at args",
  "type": "object",
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Latitude, decimal degrees (WGS-84)."
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Longitude, decimal degrees (WGS-84)."
    }
  },
  "required": [
    "lat",
    "lon"
  ],
  "additionalProperties": false
}
